# ==========================================================
# Sanctuary API - Environment Example
# Copy to .env and adjust. Never commit the real .env.
# ==========================================================

# --- App ---
APP_ENV=development
APP_NAME=sanctuary-api
HTTP_PORT=8080
LOG_LEVEL=debug
APP_TIMEZONE=Asia/Jakarta

# --- Database (PostgreSQL) ---
# Menjalankan `go run ./cmd/api` LANGSUNG DI HOST terhadap Postgres dari
# `docker compose up -d db` -> pakai port host 5434 (lihat docker-compose.yml).
# Menjalankan API DI DALAM docker compose (service `api`) -> DB_DSN di-override
# otomatis oleh compose ke db:5432, baris di bawah ini diabaikan.
DB_DSN=postgres://sanctuary:sanctuary@localhost:5434/sanctuary?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_QUERY_TIMEOUT_SECONDS=5
DB_AUTO_MIGRATE=true

# --- Redis (rate limiter / cache) ---
# Port host 6380 saat memakai `docker compose up -d redis` (lihat docker-compose.yml).
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# --- Security ---
JWT_SECRET=change-me-with-32-chars-minimum-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=720
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Rate Limit ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120
# fail-closed for auth endpoints when limiter backend is down (security standard 5.1)
RATE_LIMIT_FAIL_CLOSED=true

# --- Pagination (api-configuration-standards) ---
PAGINATION_DEFAULT_PER_PAGE=20
PAGINATION_MAX_PER_PAGE=20

# --- Privacy & Clinical Policy (never hardcode in usecase) ---
K_ANONYMITY_MIN_GROUP=5
EWS_LOOKBACK_DAYS=14
EWS_MIN_DATA_POINTS=4
EWS_LOW_MOOD_THRESHOLD=2
EWS_LOW_MOOD_MIN_STREAK_DAYS=5
EWS_NEGATIVE_EMOTION_RATIO=0.6
EWS_NEGATIVE_EMOTION_MIN_SAMPLES=4
EWS_LOW_SLEEP_HOURS=5
EWS_LOW_SLEEP_MIN_NIGHTS=2

# --- Seeder ---
SEED_DEFAULT_PASSWORD=Sanctuary123!
