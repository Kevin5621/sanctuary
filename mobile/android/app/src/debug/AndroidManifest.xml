<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- HTTP polos diizinkan HANYA pada build debug.
         Backend pengembangan berjalan di http://10.0.2.2:8080 (pemetaan emulator
         Android ke localhost mesin developer), sementara Android memblokir
         cleartext sejak targetSdk 28.

         Atribut ini SENGAJA tidak ada pada manifest utama: build release wajib
         memakai HTTPS. Menaruhnya di sana akan membuat APK produksi diam-diam
         menerima koneksi tanpa enkripsi — pada aplikasi yang membawa data
         kesehatan mental mahasiswa, itu kegagalan yang tidak boleh dibiarkan
         bergantung pada kedisiplinan konfigurasi saat rilis. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
